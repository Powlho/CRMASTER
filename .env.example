# Transcription (https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=
# Modèle utilisé pour le résumé et le compte rendu (LLM Gateway d'AssemblyAI).
# ASSEMBLYAI_LLM_MODEL=claude-sonnet-4-6

# Notion (https://www.notion.so/my-integrations)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Accès à l'application — comptes multi-utilisateurs (obligatoire dès que le site est
# exposé publiquement).
# AUTH_SECRET : générez-la avec `openssl rand -hex 32`. Toujours requise.
# APP_PASSWORD : mot de passe du tout premier compte, créé automatiquement au premier
# démarrage (identifiant "admin"). Les comptes suivants se créent depuis la page
# Administration une fois connecté — APP_PASSWORD n'est utile qu'une seule fois.
AUTH_SECRET=
APP_PASSWORD=

# Dossier de stockage des réunions (JSON). Par défaut : ./data
# DATA_DIR=/opt/crmaster/data

# Agenda Google (lecture seule) — voir la page Agenda de l'app pour la marche à suivre.
# URI de redirection à déclarer dans Google Cloud : <APP_URL>/api/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Adresse publique de l'app (ex. https://crmaster.mondomaine.fr), utilisée pour le retour de Google.
# APP_URL=

# Bibliothèque audio (téléchargement de l'audio de vidéos via yt-dlp, rangé dans DATA_DIR/library)
# YTDLP_PATH=
# Emplacement du fichier cookies YouTube envoyé depuis l'app (par défaut : DATA_DIR/youtube-cookies.txt)
# YTDLP_COOKIES_FILE=
