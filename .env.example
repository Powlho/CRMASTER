# Transcription (https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=

# Notion (https://www.notion.so/my-integrations)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Bibliothèque audio (téléchargement de l'audio de vidéos via yt-dlp)
# Dossier de stockage des fichiers audio (par défaut : ./data/audio dans le dossier de l'app)
AUDIO_STORAGE_DIR=
# Chemin vers yt-dlp si non présent dans le PATH
YTDLP_PATH=
# Emplacement du fichier cookies YouTube envoyé depuis l'app (par défaut : ./data/youtube-cookies.txt)
YTDLP_COOKIES_FILE=
