# Transcription (https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=

# Notion (https://www.notion.so/my-integrations)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Accès à l'application — comptes multi-utilisateurs (obligatoire dès que le site est
# exposé publiquement).
# AUTH_SECRET : générez-la avec `openssl rand -hex 32`. Toujours requise.
# APP_PASSWORD : mot de passe du tout premier compte, créé automatiquement au premier
# démarrage (identifiant "admin"). Les comptes suivants se créent depuis la page
# Administration une fois connecté — APP_PASSWORD n'est utile qu'une seule fois.
AUTH_SECRET=
APP_PASSWORD=

# Dossier de stockage des réunions (JSON). Par défaut : ./data
# DATA_DIR=/opt/crmaster/data
